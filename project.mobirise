    "contact.html": {
      "settings": {
        "title": "Contact Coach Praveen Singh – Book a Call | Praveen World",
        "order": "20",
        "meta_descr": "Book a Free Discovery Call with Coach Praveen Singh at Praveen World. Connect via WhatsApp, phone, or email for online worldwide & Moradabad, UP sessions.",
        "meta_image": "@PROJECT_PATH@/assets/images/praveen-world-coaching-banner.png"
      },
      "components": [
        {
          "_name": "menu2",
          "_sourceTheme": "mobirise5",
          "_styles": {
