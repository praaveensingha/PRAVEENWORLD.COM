    "personal-growth.html": {
      "settings": {
        "title": "Personal Growth & Manifestation Coaching in India | Praveen World",
        "order": "9",
        "meta_descr": "Explore Personal Growth and Manifestation Coaching with Coach Praveen Singh at Praveen World. Develop self-awareness, clarity, confidence and purposeful action. Online and Moradabad sessions."
      },
      "components": [
        {
          "_name": "menu2",
          "_sourceTheme": "mobirise5",
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "60px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
