        "order": "2",
        "meta_descr": "Explore Praveen Singh's collection of NLP & \nSubconscious Mind books — available in Hindi & \nEnglish on Amazon. Transform your mindset today!"
      },
      "components": [
        {
          "_styles": {
            "z-index": "1000",
            "width": "100%",
            "position": "relative",
