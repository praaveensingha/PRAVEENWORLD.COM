              },
              "@media (min-width: 992px) and (max-width: 1200px)": {
                "padding": "0rem 0rem",
                "margin-bottom": "0rem"
              }
            },
            ".image-wrapper img": {
              "height": "100%",
              "object-fit": "cover"
            },
            ".item-mb": {
