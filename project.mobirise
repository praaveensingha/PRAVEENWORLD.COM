              "color": "#000000"
            }
          },
          "_name": "article12",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article12\" group=\"Article\">    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4 mt-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>✨ MY APPROACH</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">DIFFERENT APPROACHES. ONE INTENTION: INNER TRANSFORMATION.</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Every person is different. There is no single approach that is right for everyone.<br>At Praveen World, I work with different approaches depending on your goals, preferences and the nature of the experience.<br><br>🧠 NLP\n<br>\n<br>Explore language, thinking patterns, beliefs and behaviour for personal development, entrepreneurship, leadership and professional growth.\n<br>\n<br>[EXPLORE NLP]\n<br>\n<br>🌙 HYPNOTHERAPY\n<br>\n<br>Explore focused attention and guided relaxation as part of personal development and inner exploration.\n<br>\n<br>[EXPLORE HYPNOTHERAPY]\n<br>\n<br>🧲 JAVANESE MAGNETISM\n<br>\n<br>Explore traditional magnetism-oriented practices, presence and energetic awareness within a holistic setting.\n<br>\n<br>[EXPLORE JAVANESE MAGNETISM]\n<br>\n<br>🌀 MESMERISM\n<br>\n<br>Explore focused attention, presence and traditional mesmerism-oriented practices.\n<br>\n<br>[EXPLORE MESMERISM]\n<br>\n<br>❤️ EMOTIONAL RELEASE\n<br>\n<br>Create space to acknowledge, understand and explore emotional experiences and patterns.\n<br>\n<br>[EXPLORE EMOTIONAL RELEASE]\n<br>\n<br>⚡ ENERGY HEALING\n<br>\n<br>A holistic wellness experience focused on relaxation, awareness, grounding and inner balance.\n<br>\n<br>[EXPLORE ENERGY HEALING]</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vsisTJjPAz",
          "_anchor": "article12-5z",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
