    "distance-healing.html": {
      "settings": {
        "title": "Distance Healing in India &amp; Worldwide | Praveen World",
        "order": "11",
        "meta_descr": "Explore Distance Healing with Coach Praveen Singh at Praveen World. Experience a complementary spiritual and energy-based wellness practice through online sessions from anywhere."
      },
      "components": [
        {
          "_name": "menu2",
          "_sourceTheme": "mobirise5",
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "60px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".dropdown-item:before": {
