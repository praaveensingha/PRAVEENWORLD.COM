anded=\"false\">Ancient Javanese Wisdom</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-765\"><a class=\"text-primary show dropdown-item\" href=\"javanese-magnetism.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Javanese Magnetism</a><a class=\"text-primary show dropdown-item\" href=\"mesmerism.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Mesmerism</a><a class=\"text-primary dropdown-item show\" href=\"ilmu-gendam.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Ilmu Gendam</a></div></div><div class=\"dropdown\"><a class=\"text-primary dropdown-item dropdown-toggle\" href=\"programs.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Personal Growth &amp; Holistic Wellness</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-525\"><a class=\"text-primary show dropdown-item\" href=\"personal-growth.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Personal Growth &amp; Manifestation</a><a class=\"text-primary show dropdown-item\" href=\"holistic-wellness.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Energy Healing &amp; Holistic Wellness</a><a class=\"text-primary dropdown-item show\" href=\"distance-healing.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Distance Healing</a></div></div></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link text-primary dropdown-toggle\" href=\"programs.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Who We Help</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-442\"><a class=\"text-primary dropdown-item\" href=\"coaching-corporate-professionals.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Corporate Professionals</a><a class=\"text-primary dropdown-item\" href=\"coaching-entrepreneurs.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Entrepreneurs &amp; Business Owners</a><a class=\"text-primary show dropdown-item\" href=\"student-parent-coaching.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Students &amp; Parents</a><a class=\"text-primary show dropdown-item\" href=\"investors-traders.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Investors &amp; Traders</a></div></li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"approach.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Our Approach</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a></li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"library.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Resources</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Contact</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary\" href=\"https://rzp.io/rzp/YZQ6QlB\" data-app-placeholder=\"Type Text\" target=\"_blank\">Book Your Discovery Call </a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
